  "evidence": "Fresh static inspection of the exact recovered assembly. Behavioral summaries and method identifiers only; no original assembly or disassembly is published. These findings are not an original-game execution oracle.",
  "rules": [
    {
      "rule": "potion rarity selection",
      "methods": {
        "PotionFactory.CreateRandomPotions": "0x06004f1b"
      },
      "finding": "Select rarity first: rare 10%, uncommon 25%, common 65%, then select a model in that rarity.",
      "implementation": "random_potion uses the same probability weights with the expedition's independent integer RNG. Original floating-point draws and PC seeds are not reproduced."
    },
    {
      "rule": "combat generation restrictions",
      "methods": {
        "PotionFactory.CreateRandomPotionInCombat": "0x06004f1a",
        "FairyInABottle.get_CanBeGeneratedInCombat": "0x06002b2c",
        "FruitJuice.get_CanBeGeneratedInCombat": "0x06002b57",
        "RegenPotion.get_CanBeGeneratedInCombat": "0x06002be5"
      },
      "finding": "The combat factory filters CanBeGeneratedInCombat; these three active models return false.",
      "implementation": "Explicit combat context filters Alchemize generation without accidentally filtering victory drops while their state is still Combat."
    },
    {
      "rule": "Entropic Brew exception",
      "methods": {
        "EntropicBrew.<OnUse>d__6.MoveNext": "0x0600a11c",
        "PotionFactory.CreateRandomPotionOutOfCombat": "0x06004f18"
      },
      "finding": "Always calls the out-of-combat factory separately for each open potion slot, with null exclusions. Recovery bottles, repeated models and Entropic Brew itself are allowed even when used during combat.",
      "implementation": "Preserves occupied slots and uses random_potion(state,false) for each empty slot after consuming the bottle."
    },
    {
      "rule": "temporary cost lifetime and X cost",
      "methods": {
        "CardModel.SetToFreeThisTurn": "0x060018c5",
        "CardModel.SetToFreeThisCombat": "0x060018c6",
        "CardEnergyCost.SetThisTurnOrUntilPlayed": "0x06005223",
        "CardEnergyCost.GetWithModifiers": "0x0600521d",
        "CardEnergyCost.<AfterCardPlayedCleanup>b__32_0": "0x0600b0cc",
        "CardModel.<OnPlayWrapper>d__339.MoveNext": "0x06009b06",
        "SneckoOil.<OnUse>b__12_0": "0x0600a174",
        "SneckoOil.<OnUse>d__12.MoveNext": "0x0600a175"
      },
      "finding": "Temporary free effects and Snecko costs expire after the first completed physical play/replay group or at turn end. X/negative canonical costs bypass local modifiers; Snecko skips X and negative effective costs before sampling.",
      "implementation": "The existing turn_cost array is cleared after the completed play. Its serialized representation is retained. The cost getter preserves negative/X values; Touch of Insanity clears earlier temporary overrides."
    },
    {
      "rule": "Clarity and Radiance stacking",
      "methods": {
        "ClarityPower.ModifyHandDraw": "0x06002487",
        "ClarityPower.<AfterSideTurnStart>d__5.MoveNext": "0x06009e8c",
        "RadiancePower.get_CanonicalVars": "0x060027b9",
        "RadiancePower.<AfterEnergyReset>d__8.MoveNext": "0x06009fc6"
      },
      "finding": "Each applicable turn grants a fixed one extra card or energy and decrements one layer; layers extend duration.",
      "implementation": "Existing duration representation retained; two-bottle regressions verify six turns of one extra benefit."
    },
    {
      "rule": "Duplicator stacking",
      "methods": {
        "DuplicationPower.ModifyCardPlayCount": "0x06002557",
        "DuplicationPower.<AfterModifyingCardPlayCount>d__5.MoveNext": "0x06009ee2",
        "DuplicationPower.AfterSideTurnEnd": "0x06002559"
      },
      "finding": "Adds one replay, decrements one layer per modified card play, and expires unused layers after the side turn.",
      "implementation": "Existing next-N-cards behavior retained and covered by a two-bottle, three-card numerical regression."
    },
    {
      "rule": "Soldier's Stew instance scope",
      "methods": {
        "SoldiersStew.OnUse": "0x06002c0a",
        "SoldiersStew.<OnUse>b__8_0": "0x0600a179"
      },
      "finding": "Enumerates the current combat cards, filters the Strike tag, and increments each existing instance's BaseReplayCount. No generation listener is installed.",
      "implementation": "Existing instance replay fields retained; a Strike created after use receives no retroactive replay."
    },
    {
      "rule": "Bottled Potential pile scope",
      "methods": {
        "BottledPotential.<OnUse>d__8.MoveNext": "0x0600a106",
        "CardPileCmd.<Shuffle>d__22.MoveNext": "0x0600b27e"
      },
      "finding": "Moves the hand into draw, shuffles draw and discard together, then draws five. Does not recover exhausted cards or installed powers.",
      "implementation": "Equivalent pile membership is retained without discard triggers. Added an exhaust/power preservation and nested Stratagem-selection regression."
    },
    {
      "rule": "generated card pools and distinct batches",
      "methods": {
        "AttackPotion.<OnUse>d__6.MoveNext": "0x0600a0fc",
        "OrobicAcid.<OnUse>d__6.MoveNext": "0x0600a150",
        "CosmicConcoction.<OnUse>d__8.MoveNext": "0x0600a10c",
        "CardFactory.GetDistinctForCombat": "0x06004f0c"
      },
      "finding": "Attack/skill/power generation uses the owner's character pool and combat eligibility. Cosmic Concoction requests three distinct colorless models before upgrading and adding them.",
      "implementation": "Shared generation filters apply the supported owner's pool. Generate flags retain free/upgraded low bits and encode an optional distinct batch count above them; Cosmic Concoction requests count 3, upgraded."
    },
    {
      "rule": "Plating timing",
      "methods": {
        "PlatingPower.BeforeSideTurnStart": "0x0600278a",
        "PlatingPower.BeforeSideTurnEndEarly state machine": "0x06009fb2",
        "PlatingPower.AfterSideTurnStart state machine": "0x06009fb0"
      },
      "finding": "For players, grants current-amount block at side-turn end, then decrements at the next applicable side-turn start; the start-turn block branch excludes players.",
      "implementation": "Removes the duplicate player-start block payment. Heart of Iron is tested against an actual enemy attack before the next player turn."
    },
    {
      "rule": "Fairy outside combat and fractional healing",
      "methods": {
        "FairyInABottle.ShouldDie": "0x06002b2e",
        "FairyInABottle.<AfterPreventingDeath>d__10.MoveNext": "0x0600a122",
        "RunState.<IterateHookListeners>d__118.MoveNext": "0x060097bc",
        "Hook.ShouldDie": "0x06004cee",
        "CreatureCmd.<KillWithoutCheckingWinCondition>d__15.MoveNext": "0x0600b30d",
        "Creature.SetCurrentHpInternal": "0x060051da"
      },
      "finding": "Run-level death prevention includes carried potions without a combat state. Positive fractional resulting HP is truncated when stored, with Fairy ensuring at least 1 HP.",
      "implementation": "The common revival path supports lethal event HP loss. Actual Baths/Vegetation event tests cover one-bottle consumption, continuation, nonlethal preservation and death without a bottle."
    },
    {
      "rule": "full-hand pile selection",
      "methods": {
        "DropletOfPrecognition.<OnUse>d__6.MoveNext": "0x0600a116",
        "LiquidMemories.<OnUse>d__6.MoveNext": "0x0600a145",
        "CardSelectCmd.<FromCombatPile>d__20.MoveNext": "0x0600b2b8",
        "CardPileCmd.<Add>d__10.MoveNext": "0x0600b258"
      },
      "finding": "Selection from draw/discard does not check hand capacity. Adding the selected card to a full hand redirects it to discard after removing it from its old pile. Liquid Memories applies its temporary free cost before that move.",
      "implementation": "Full hands still allow mandatory selection. Droplet moves the chosen draw instance to discard; Liquid Memories retains the chosen discard instance with its free cost. The original hand stays intact and No Draw does not suppress the explicit move."
    },
    {
      "rule": "Touch of Insanity eligibility",
      "methods": {
        "TouchOfInsanity.<OnUse>b__6_0": "0x0600a186",
        "CardModel.CostsEnergyOrStars": "0x060018db"
      },
      "finding": "Selects only cards with a positive payable local or fully modified energy/star cost. X, zero-cost and currently free cards are excluded.",
      "implementation": "The supported card set has no star costs or additional global cost hooks, so the hand predicate uses the current cost > 0. An empty eligible pool completes the potion without a choice."
    },
    {
      "rule": "Distilled Chaos reserves a batch",
      "methods": {
        "DistilledChaos.<OnUse>d__8.MoveNext": "0x0600a114",
        "CardPileCmd.<AutoPlayFromDrawPile>d__23.MoveNext": "0x0600b26e"
      },
      "finding": "The draw-pile auto-play command moves the available batch into Limbo before playing its first card. Earlier plays cannot draw or shuffle the cards already reserved for later plays.",
      "implementation": "One AutoTop count-3 operation reserves serialized AutoInstance continuations. Tests cover a first card that draws, reservation interrupted by a shuffle choice, and cleanup on early victory."
    },
    {
      "rule": "Doom precedes Demise on the enemy side",
      "methods": {
        "DoomPower.<BeforeSideTurnEnd>d__8.MoveNext": "0x06009ed6",
        "DoomPower.<AfterSideTurnEnd>d__9.MoveNext": "0x06009ed4",
        "DemisePower.<AfterSideTurnEnd>d__4.MoveNext": "0x06009ec8"
      },
      "finding": "CombatSide.Player=1 and Enemy=2. Doom uses BeforeSideTurnEnd for enemies and skips their AfterSideTurnEnd. Demise applies afterward. A creature at 40 HP with 33 Doom and 9 Demise survives the first enemy-turn end at 31 HP.",
      "implementation": "The enemy resolution checks Doom before applying Demise, and skips the HP-loss step if Doom already killed the creature."
    },
    {
      "rule": "temporary cost cleanup precedes the enemy phase",
      "methods": {
        "CombatManager.<EndPlayerTurnPhaseTwoInternal>d__139.MoveNext": "0x0600b3c0",
        "CombatManager.<FlushPlayerHand>d__140.MoveNext": "0x0600b3c4",
        "PlayerCombatState.EndOfTurnCleanup": "0x060050d4",
        "CardModel.EndOfTurnCleanup": "0x060018de",
        "CardEnergyCost.EndOfTurnCleanup": "0x0600522a",
        "CombatManager.<EndEnemyTurnInternal>d__136.MoveNext": "0x0600b3b8"
      },
      "finding": "The player phase waits for FlushPlayerHand and its AfterFlush hooks before AfterSideTurnEnd. Flush then cleans all card instances, including retained, draw, discard and exhaust cards, removing turn-expiring costs. Enemy-turn end also performs cleanup.",
      "implementation": "The existing turn_cost storage is cleared at the player-flush boundary before enemies act. A regression suspends Centennial Puzzle at a Stratagem shuffle choice during enemy damage on turn 1 and checks that temporary costs have expired while permanent free costs remain."
    }
  ],
